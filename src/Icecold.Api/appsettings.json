{
  "ConnectionStrings": {
    // PostgreSQL connection string used by EF Core.
    "Icecold": "Host=localhost;Port=55432;Database=icecold;Username=icecold;Password=icecold"
  },
  "Icecold": {
    // Base URL embedded into tracker announce URLs and, when WebSeed is enabled, webseed URLs returned to clients.
    "PublicBaseUrl": "http://localhost:5038",
    // Required for all /api/* admin endpoints. Clients must supply this in the X-Icecold-Admin-Key header.
    // Intentionally absent here — provide via environment variable or secret in production.
    // In development, compose.yaml sets this to "dev-admin-key"; local appsettings.Development.json files are ignored by git.
    // "AdminApiKey": "",
    "Database": {
      // Run pending EF Core migrations automatically on startup. The production Compose file
      // enables this via ICECOLD_AUTO_MIGRATE. Set to false to manage migrations manually.
      "AutoMigrate": false
    },
    "Indexing": {
      // Number of parallel hashing workers that process the indexing queue. Min 1.
      "MaxConcurrency": 1,
      // Maximum number of pending indexing jobs held in memory before EnqueueAsync blocks. Min 1.
      "QueueCapacity": 10000
    },
    "ReverseProxy": {
      // Trust X-Forwarded-For and X-Forwarded-Proto from explicitly configured reverse proxies.
      // Leave disabled when Icecold receives tracker/webseed HTTP traffic directly.
      "Enabled": false,
      // Exact proxy IP addresses allowed to supply forwarded headers, for example "127.0.0.1" or "172.20.0.5".
      "KnownProxies": [],
      // Proxy source IP/CIDR ranges allowed to supply forwarded headers, for example "172.20.0.0/16".
      "KnownNetworks": [],
      // Number of forwarded hops to process from the right side of X-Forwarded-For.
      "ForwardLimit": 1
    },
    "Tracker": {
      // Enable Icecold's public /announce and /scrape endpoints and inject Icecold's /announce URL into generated .torrent files and magnet links.
      // If disabled, AdditionalAnnounceUrls are still emitted, but WebSeed must be enabled because Icecold does not announce itself through DHT, PEX, or external trackers.
      "Enabled": true,
      // Store and return public peers that announce to Icecold. Set false to make the tracker read-only and only advertise Icecold's own peer-wire seed.
      "TrackPublicPeers": true,
      // Recommended reannounce interval returned to clients, in seconds. (Default: 30 min)
      "AnnounceIntervalSeconds": 1800,
      // Minimum reannounce interval returned to clients, in seconds. (Default: 5 min)
      "MinAnnounceIntervalSeconds": 300,
      // Time after which a peer that has stopped announcing is removed from the in-memory store. (Default: 45 min)
      "PeerTimeoutSeconds": 2700,
      // Maximum number of peers returned in a single announce response.
      "MaxPeersReturned": 200,
      // Maximum number of peers retained per infohash before evicting least-recently announced peers.
      "MaxPeersStoredPerTorrent": 1000,
      // Background pruning interval for expired peers and empty infohash buckets, in seconds.
      "PruneIntervalSeconds": 300,
      // Optional additional tracker announce URLs injected into .torrent files and magnet links.
      // When Tracker:Enabled is true, Icecold's tracker is emitted first. Entries must be absolute http, https, or udp tracker URLs.
      "AdditionalAnnounceUrls": [],
      // HTTP source IPs/CIDRs allowed to supply the BitTorrent announce ip= parameter after ReverseProxy normalization. Leave empty to always use the request remote IP.
      // Only add sources that are trusted to choose peer IPs.
      "TrustedIpParameterSources": [],
      // Maximum non-stopped announces accepted from one source IP per minute. Set to 0 to disable tracker announce rate limiting.
      "MaxAnnouncesPerSourceIpPerMinute": 120
    },
    "Stats": {
      // Enable the public /stats endpoint.
      "Enabled": true,
      // Public /stats response cache duration, in seconds. Set to 0 to disable server-side stats caching.
      "CacheSeconds": 5
    },
    "WebSeed": {
      // Enable HTTP webseed serving and advertise /webseed URLs in .torrent files and magnet links.
      // At least one serving transport must be enabled: WebSeed or PeerWire.
      "Enabled": true,
      // Optional public base URL for advertised webseed URLs. Leave empty to use Icecold:PublicBaseUrl.
      // Set this to a CDN or reverse-proxy origin when /webseed is exposed through a different public host.
      "PublicBaseUrl": ""
    },
    "PeerWire": {
      // Enable the upload-only TCP peer-wire seeding listener.
      // At least one serving transport must be enabled: WebSeed or PeerWire.
      "Enabled": false,
      "SuperSeed": {
        // Enable initial/super-seeding behavior: advertise a small piece window per peer instead of a full bitfield.
        "Enabled": false,
        // Minimum active peer-wire connections for this infohash before using super-seeding. 0 means always super-seed when Enabled is true.
        "MinimumPeerCount": 0,
        // Number of pieces to advertise to each peer at once while super-seeding.
        "MaxPiecesPerPeer": 1
      },
      "Standby": {
        // When enabled, Icecold only advertises/uploads peer-wire for an infohash while the tracker sees fewer standby-eligible external complete peers than MinimumExternalSeeders.
        "Enabled": false,
        // Desired count of non-Icecold complete source IPs before Icecold stands down. Partial and newly-seen complete peers do not count.
        "MinimumExternalSeeders": 2,
        // Complete peers must be seen for at least this many seconds before they can make Icecold stand down.
        "MinimumExternalSeederAgeSeconds": 300
      },
      // Local IP address to bind the listener. 0.0.0.0 listens on all interfaces.
      "BindAddress": "0.0.0.0",
      // TCP port to listen on for incoming peer connections.
      "ListenPort": 6881,
      // Public IP address advertised in tracker responses. Must be an IP address, not a hostname —
      // BitTorrent compact peer responses cannot carry DNS names. Required when Enabled is true.
      "AdvertisedIp": "",
      // Public port advertised in tracker responses. Can differ from ListenPort when behind NAT.
      "AdvertisedPort": 6881,
      // Maximum piece block size accepted from peers, in bytes. 16384 (16 KiB) is the BitTorrent standard.
      // Requests larger than MaxBlockLength + 1024 bytes are rejected.
      "MaxBlockLength": 16384,
      // Advertised as reqq in the extension handshake: the number of outstanding requests a peer may pipeline.
      "MaxOutstandingRequests": 8192,
      // Maximum number of concurrent peer connections. New connections are rejected once this is reached.
      "MaxConnections": 128,
      // Maximum concurrent peer connections from a single remote IP address. Must not exceed MaxConnections.
      "MaxConnectionsPerIp": 8,
      // Overall deadline for completing the BitTorrent or MSE/RC4 handshake before dropping the connection, in seconds.
      "HandshakeTimeoutSeconds": 15,
      // Timeout before an idle connection with no messages (including keepalives) is closed, in seconds.
      // Also bounds each write, so a peer that stops reading cannot hold a connection slot.
      "IdleTimeoutSeconds": 120
    },
    // Named content sources. Multiple sources can be defined for separate hot/cold paths.
    // If omitted entirely, a default "local" source is created at {ContentRootPath}/data/files.
    "ContentSources": [
      {
        // Unique source identifier (case-insensitive). Used in indexing requests and stored with each torrent.
        "Name": "local",
        // Source type. Only "local" is implemented; S3 and HTTP sources are not yet available.
        "Type": "local",
        // Base directory for this source. Relative paths are resolved from the application content root.
        "RootPath": "./data/files"
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
